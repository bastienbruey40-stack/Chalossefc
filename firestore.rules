rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie que l'utilisateur est connecté
    function estConnecte() {
      return request.auth != null;
    }

    // Fonction Super Admin basée sur l'adresse email de confiance
    function estSuperAdmin() {
      return estConnecte() && request.auth.token.email == "bastienbruey1@gmail.com";
    }

    // Vérifie que l'utilisateur connecté possède le rôle "admin" ou est super admin
    function estAdmin() {
      return estConnecte() && (
        estSuperAdmin() ||
        (exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role == "admin")
      );
    }

    // 1. COLLECTION "utilisateurs" (Comptes & Joueurs de l'effectif)
    match /utilisateurs/{userId} {
      // Lecture réservée aux membres connectés du club
      allow read: if estConnecte();

      // Inscription : un utilisateur ne peut créer que sa propre fiche (le Super Admin est automatiquement admin)
      allow create: if estAdmin() || (
        estConnecte() &&
        request.auth.uid == userId &&
        (request.resource.data.role == "utilisateur" || estSuperAdmin())
      );

      // Mise à jour : SEUL le Super Admin peut modifier le rôle d'un compte (Utilisateur <-> Admin)
      // Les admins classiques ou les utilisateurs ne peuvent modifier leur profil que si le rôle reste IDENTIQUE
      allow update: if estSuperAdmin() || (
        estConnecte() &&
        request.resource.data.role == resource.data.role &&
        (estAdmin() || request.auth.uid == userId)
      );

      // Suppression : réservée à l'admin (ou à l'utilisateur qui purge son propre compte)
      allow delete: if estAdmin() || (estConnecte() && request.auth.uid == userId);
    }

    // 2. COLLECTION "matchs" (Calendrier, scores, compositions, statistiques)
    match /matchs/{matchId} {
      allow read: if estConnecte();
      allow create, update, delete: if estAdmin();
    }

    // 3. COLLECTION "notes" (Votes Homme du match)
    match /notes/{noteId} {
      allow read: if estConnecte();

      // Tout membre connecté peut enregistrer ou modifier sa propre note
      allow create, update: if estConnecte() &&
        (
          request.resource.data.voterId == request.auth.uid ||
          request.resource.data.votant_id == request.auth.uid ||
          estAdmin()
        );

      // Un administrateur peut supprimer des notes, ou un utilisateur sa propre note
      allow delete: if estAdmin() || (
        estConnecte() &&
        (resource.data.voterId == request.auth.uid || resource.data.votant_id == request.auth.uid)
      );
    }

    // 4. COLLECTION "saisons"
    match /saisons/{saisonId} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }
  }
}
